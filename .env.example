# Copy to .env (next to docker-compose.yml) to override the defaults.
# App secrets (JWT_SECRET, EMAIL_*, ANTHROPIC_API_KEY) stay in telecom-backend/.env.

# Database (used to create the container DB and to build the backend's DATABASE_URL).
# Avoid URL-special characters (@ : / ? #) in the password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telecom_gis

# Host ports (3000 / 5432 / 5433 are often taken by local dev servers / Postgres)
FRONTEND_PORT=8080
BACKEND_PORT=5000
DB_PORT=5434

# Must match FRONTEND_PORT: used in password-reset email links
FRONTEND_URL=http://localhost:8080
