// CI for telecom-backend
//   build image (compiles the TypeScript) -> push to Docker Hub, tagged with the build number
//
// Jenkins job: Pipeline script from SCM, repo https://github.com/JendoubiMajdi/Telecom-Gis.git,
// branch */development, Script Path telecom-backend/Jenkinsfile
//
// Credentials (Manage Jenkins > Credentials, kind "Username with password"):
//   dockerhub : majdi99 + Docker Hub access token (Read & Write)
//
// The agent needs a Linux shell, git and a Docker CLI that can reach a Docker daemon.

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  triggers {
    // Stands in for a push webhook (GitHub cannot reach a local Jenkins): checks the
    // development branch every 2 minutes and builds only when there are new commits
    pollSCM('H/2 * * * *')
  }

  environment {
    APP_DIR = 'telecom-backend'
    IMAGE   = 'docker.io/majdi99/telecom-backend'
    TAG     = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Release') {
      // Runs when started by hand, or on a push to development that touches telecom-backend/
      when {
        anyOf {
          triggeredBy 'UserIdCause'
          allOf {
            expression { env.GIT_BRANCH == 'origin/development' }
            changeset 'telecom-backend/**'
          }
        }
      }
      stages {
        stage('Build image') {
          steps {
            sh 'docker build --pull -t "$IMAGE:$TAG" -t "$IMAGE:latest" "$APP_DIR"'
          }
        }

        stage('Push image') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
              sh '''
                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                docker push "$IMAGE:$TAG"
                docker push "$IMAGE:latest"
              '''
            }
          }
          post {
            always {
              sh 'docker logout || true'
            }
          }
        }
      }
    }
  }

  post {
    success {
      echo "Pushed ${env.IMAGE}:${env.TAG}"
    }
    always {
      sh 'docker image prune -f || true'
    }
  }
}
