// CI for telecom-backend
//   build image (compiles the TypeScript) -> smoke test /health -> push to Docker Hub
//   -> bump image.tag in the gitops repo -> Argo CD deploys it
//
// Jenkins job: Pipeline script from SCM, repo https://github.com/JendoubiMajdi/Telecom-Gis.git,
// branch */main, Script Path telecom-backend/Jenkinsfile
//
// Credentials (Manage Jenkins > Credentials, kind "Username with password"):
//   dockerhub-creds : majdi99 + Docker Hub access token (Read & Write)
//   github-gitops   : JendoubiMajdi + GitHub token with write access to telecom-gis-gitops
//
// The agent needs a Linux shell, git and a Docker CLI that can reach a Docker daemon.

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  triggers {
    // GitHub cannot reach a local Jenkins with a webhook, so poll instead
    pollSCM('H/2 * * * *')
  }

  environment {
    APP_DIR       = 'telecom-backend'
    IMAGE         = 'docker.io/majdi99/telecom-backend'
    GITOPS_REPO   = 'https://github.com/JendoubiMajdi/telecom-gis-gitops.git'
    GITOPS_BRANCH = 'main'
    VALUES_FILE   = 'charts/backend/values.yaml'
    SMOKE_CTR     = "ci-backend-${env.BUILD_NUMBER}"
  }

  stages {
    stage('Release') {
      // Only when backend files changed, or when started by hand (the first build has no changeset)
      when {
        anyOf {
          changeset 'telecom-backend/**'
          triggeredBy 'UserIdCause'
        }
      }
      stages {
        stage('Version') {
          steps {
            script {
              def sha = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
              env.TAG = "${env.BUILD_NUMBER}-${sha}"
              currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.TAG}"
            }
          }
        }

        stage('Build image') {
          steps {
            sh 'docker build --pull -t "$IMAGE:$TAG" -t "$IMAGE:latest" "$APP_DIR"'
          }
        }

        stage('Smoke test') {
          steps {
            // /health answers even without a database (connection errors are only logged)
            sh '''
              docker run -d --name "$SMOKE_CTR" -e EMAIL_ENABLED=false -e JWT_SECRET=ci-smoke-test "$IMAGE:$TAG"
              ok=0
              for i in $(seq 1 20); do
                if docker exec "$SMOKE_CTR" wget -qO- http://127.0.0.1:5000/health; then ok=1; break; fi
                sleep 2
              done
              docker logs "$SMOKE_CTR" 2>&1 | tail -20
              [ "$ok" = 1 ]
            '''
          }
          post {
            always {
              sh 'docker rm -f "$SMOKE_CTR" || true'
            }
          }
        }

        stage('Push image') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
              sh '''
                echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                docker push "$IMAGE:$TAG"
                docker push "$IMAGE:latest"
              '''
            }
          }
          post {
            always {
              sh 'docker logout || true'
            }
          }
        }

        stage('Deploy (bump gitops)') {
          steps {
            withCredentials([usernamePassword(credentialsId: 'github-gitops', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
              sh '''
                set -e
                # The token is read from the environment by a one-off credential helper,
                # so it never lands in .git/config or in the build log
                g() { git -c credential.helper= -c credential.helper='!f() { echo "username=$GIT_USER"; echo "password=$GIT_TOKEN"; }; f' "$@"; }

                SRC_SHA=$(git rev-parse HEAD)
                rm -rf gitops
                g clone --branch "$GITOPS_BRANCH" "$GITOPS_REPO" gitops
                cd gitops

                sed -i "s|^  tag: .*|  tag: \\"$TAG\\"|" "$VALUES_FILE"
                grep -q "^  tag: \\"$TAG\\"" "$VALUES_FILE"
                if git diff --quiet; then
                  echo "$VALUES_FILE already at $TAG, nothing to release"
                  exit 0
                fi

                git config user.name "Jenkins CI"
                git config user.email "jenkins@telecom-gis.local"
                git commit -am "backend: release $TAG" -m "Source: https://github.com/JendoubiMajdi/Telecom-Gis/commit/$SRC_SHA"

                # The frontend pipeline pushes to the same repo, so rebase and retry on a race
                for i in 1 2 3; do
                  if g push origin "HEAD:$GITOPS_BRANCH"; then exit 0; fi
                  g pull --rebase origin "$GITOPS_BRANCH"
                done
                exit 1
              '''
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        if (env.TAG) {
          echo "Released ${env.IMAGE}:${env.TAG}. Argo CD will roll it out on its next sync."
        }
      }
    }
    always {
      sh 'rm -rf gitops; docker image prune -f || true'
    }
  }
}
